generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  name           String?         @db.VarChar(255)
  email          String          @unique @db.VarChar(255)
  password       String          @db.VarChar(255)
  age            Int?
  weight         Float?
  height         Float?
  goal           String?         @db.VarChar(50)
  activity_level String?         @db.VarChar(50)
  streak         Int?            @default(0)
  level          Int?            @default(1)
  points         Int?            @default(0)
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  workouts       Workout[]
  nutrition_logs NutritionLog[]

  @@map("users")
}

model Workout {
  id         Int               @id @default(autoincrement())
  user_id    Int?
  date       DateTime          @db.Date
  mode       String            @db.VarChar(50)
  created_at DateTime?         @default(now()) @db.Timestamp(6)
  user       User?             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exercises  WorkoutExercise[]

  @@map("workouts")
}

model WorkoutExercise {
  id          Int          @id @default(autoincrement())
  workout_id  Int?
  exercise_id String       @db.VarChar(255)
  name        String?      @db.VarChar(255)
  workout     Workout?     @relation(fields: [workout_id], references: [id], onDelete: Cascade)
  sets        WorkoutSet[]

  @@map("workout_exercises")
}

model WorkoutSet {
  id          Int              @id @default(autoincrement())
  exercise_id Int?
  reps        Int              @default(0)
  weight      Float            @default(0)
  completed   Boolean?         @default(false)
  exercise    WorkoutExercise? @relation(fields: [exercise_id], references: [id], onDelete: Cascade)

  @@map("workout_sets")
}

model NutritionLog {
  id            Int       @id @default(autoincrement())
  user_id       Int?
  date          DateTime  @db.Date
  water_glasses Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  user          User?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  foods         Food[]

  @@map("nutrition_logs")
}

model Food {
  id         Int           @id @default(autoincrement())
  log_id     Int?
  meal       String        @db.VarChar(50)
  name       String        @db.VarChar(255)
  calories   Int
  protein    Int?          @default(0)
  carbs      Int?          @default(0)
  fat        Int?          @default(0)
  created_at DateTime?     @default(now()) @db.Timestamp(6)
  log        NutritionLog? @relation(fields: [log_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("foods")
}

model ExerciseMaster {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(255)
  category         String   @db.VarChar(100) // e.g. "gym", "home", "yoga", "running"
  description      String?  @db.Text
  difficulty_level String   @default("Beginner") @db.VarChar(50) // Beginner, Intermediate, Expert
  xp_reward        Int      @default(10)
  image_url        String?  @db.VarChar(255)

  @@map("exercise_master")
}

model FoodMaster {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  brand        String?  @db.VarChar(255)
  meal_type    String?  @db.VarChar(50) // "breakfast", "lunch", "dinner", "snack"
  calories     Int
  protein      Int      @default(0)
  carbs        Int      @default(0)
  fat          Int      @default(0)
  health_score Int      @default(100)

  @@map("food_master")
}
